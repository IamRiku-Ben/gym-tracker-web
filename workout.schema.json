{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gym-training-log/schemas/workout.schema.json",
  "title": "Workout log",
  "description": "Ein Training pro Datei, Dateiname YYYY-MM-DD.json. Version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "timezone",
    "session_name",
    "exercises"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string",
      "const": "Europe/Berlin"
    },
    "session_name": {
      "type": "string",
      "minLength": 1
    },
    "source_chat": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/exercise"
      }
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "test"
      ],
      "description": "Optionale Kennzeichnung. test-Dateien dürfen nicht in echte Trainingsstatistiken einfließen."
    },
    "test_run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Kennung der Probesitzung; nur für Testdatensätze."
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise_id",
        "load_basis",
        "sets"
      ],
      "properties": {
        "exercise_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "load_basis": {
          "enum": [
            "total",
            "per_side",
            "dumbbell_each",
            "machine_display",
            "bodyweight",
            "unknown"
          ]
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/set"
          }
        },
        "notes": {
          "type": "string"
        },
        "next_time": {
          "type": "string"
        }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "reps",
        "weight_kg"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "reps": {
          "type": "integer",
          "minimum": 0
        },
        "weight_kg": {
          "type": "number",
          "minimum": 0
        },
        "rir": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "is_warmup": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
